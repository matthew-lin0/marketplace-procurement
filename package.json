{
  "name": "marketplace-eval",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser extension that tells you what a used-goods listing does not say, plus the eval harness that tests it.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sink": "tsx src/eval/sink.ts",
    "eval": "tsx src/eval/run.ts",
    "baseline": "tsx src/eval/baseline.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:data-boundary": "tsx src/eval/checkDataBoundary.ts",
    "smoke": "tsx src/eval/smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "yaml": "^2.6.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true
  }
}